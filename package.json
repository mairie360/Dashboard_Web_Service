{
  "name": "frontend-nextjs-template",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "eslint src",
    "contracts:generate": "node scripts/contracts.mjs --generate",
    "contracts:check": "node scripts/contracts.mjs --check",
    "contracts:sync": "node scripts/contracts.mjs --sync",
    "test:contracts": "node --test tests/*.test.cjs",
    "test:node": "mkdir -p coverage && node --enable-source-maps --test --experimental-test-coverage --test-coverage-branches=60 --test-coverage-functions=60 --test-coverage-lines=60 --test-coverage-include='src/**' --test-reporter=spec --test-reporter-destination=stdout --test-reporter=lcov --test-reporter-destination=coverage/lcov.info tests/*.test.cjs",
    "test:components": "vitest run --coverage",
    "test": "npm run test:node && npm run test:components",
    "performance:report": "node scripts/frontend-performance.mjs"
  },
  "dependencies": {
    "@mairie360/bff-dashboard-openapi": "0.0.0-dev.c89c35c703aa429faec94072338a56f7de084687",
    "@mairie360/front-kit": "file:vendor/mairie360-front-kit-0.1.0.tgz",
    "@mairie360/lib-components": "0.8.0",
    "axios": "1.20.0",
    "lucide-react": "1.0.0",
    "next": "16.3.8",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "^24.0.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "5.0.2",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "jest-axe": "11.0.0",
    "jsdom": "30.1.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "5.0.2",
    "playwright-core": "1.64.0"
  },
  "overrides": {
    "postcss": "8.5.28",
    "next": {
      "sharp": "^0.35.5"
    }
  }
}
