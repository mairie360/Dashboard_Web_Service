{
  "openapi": "3.1.0",
  "info": {
    "title": "bff_dashboard",
    "version": "1.0.0"
  },
  "paths": {
    "/health": {
      "get": {
        "operationId": "getHealth",
        "parameters": [],
        "responses": {
          "2XX": {
            "description": "Succès (seul statut typé par orval)"
          }
        }
      }
    },
    "/check_apis": {
      "get": {
        "operationId": "getCheckApis",
        "parameters": [],
        "responses": {
          "2XX": {
            "description": "Succès (seul statut typé par orval)"
          }
        }
      }
    },
    "/dashboard/bootstrap": {
      "get": {
        "operationId": "getDashboardBootstrap",
        "parameters": [],
        "responses": {
          "2XX": {
            "description": "Succès (seul statut typé par orval)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DashboardBootstrap"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "DashboardBootstrap": {
        "type": "object",
        "properties": {
          "userFirstName": {
            "type": "string"
          },
          "projects": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/DashboardBootstrapProjectsItem"
            }
          },
          "tasks": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/DashboardBootstrapTasksItem"
            }
          },
          "events": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/DashboardBootstrapEventsItem"
            }
          },
          "metrics": {
            "$ref": "#/components/schemas/DashboardBootstrapMetrics"
          },
          "sources": {
            "$ref": "#/components/schemas/DashboardBootstrapSources"
          }
        },
        "required": [
          "userFirstName",
          "projects",
          "tasks",
          "events",
          "metrics",
          "sources"
        ]
      },
      "DashboardBootstrapEventsItem": {
        "type": "object",
        "properties": {
          "id": {
            "type": [
              "string",
              "number"
            ]
          },
          "title": {
            "type": "string"
          },
          "date": {
            "type": "string"
          },
          "startTime": {
            "type": "string"
          },
          "location": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "title",
          "date"
        ]
      },
      "DashboardBootstrapMetrics": {
        "type": "object",
        "properties": {
          "totalProjects": {
            "type": [
              "number",
              "null"
            ]
          }
        },
        "required": [
          "totalProjects"
        ]
      },
      "DashboardBootstrapProjectsItem": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "progress": {
            "type": "number"
          },
          "status": {
            "$ref": "#/components/schemas/DashboardBootstrapProjectsItemStatus"
          },
          "dueDate": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "title",
          "progress",
          "status",
          "dueDate"
        ]
      },
      "DashboardBootstrapProjectsItemStatus": {
        "type": "string",
        "enum": [
          "todo",
          "in-progress",
          "review",
          "done"
        ]
      },
      "DashboardBootstrapSources": {
        "type": "object",
        "properties": {
          "projects": {
            "$ref": "#/components/schemas/DashboardBootstrapSourcesProjects"
          },
          "tasks": {
            "$ref": "#/components/schemas/DashboardBootstrapSourcesTasks"
          },
          "calendar": {
            "$ref": "#/components/schemas/DashboardBootstrapSourcesCalendar"
          }
        },
        "required": [
          "projects",
          "tasks",
          "calendar"
        ]
      },
      "DashboardBootstrapSourcesCalendar": {
        "type": "string",
        "enum": [
          "available",
          "unavailable"
        ]
      },
      "DashboardBootstrapSourcesProjects": {
        "type": "string",
        "enum": [
          "available",
          "unavailable"
        ]
      },
      "DashboardBootstrapSourcesTasks": {
        "type": "string",
        "enum": [
          "available",
          "unavailable"
        ]
      },
      "DashboardBootstrapTasksItem": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "dueDate": {
            "type": "string"
          },
          "priority": {
            "$ref": "#/components/schemas/DashboardBootstrapTasksItemPriority"
          },
          "completed": {
            "type": "boolean"
          },
          "projectId": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "title",
          "dueDate",
          "priority",
          "completed",
          "projectId"
        ]
      },
      "DashboardBootstrapTasksItemPriority": {
        "type": "string",
        "enum": [
          "high",
          "medium",
          "low"
        ]
      }
    }
  }
}
